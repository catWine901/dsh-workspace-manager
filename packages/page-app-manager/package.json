{
  "name": "@deepseek-ai/dsh-page-app-manager",
  "description": "Host page-app manager: profile-scoped ownership projection, install-source parsing, static Workspace Contract validation, and the read-only manager service (transactions and Remote come in later tasks)",
  "version": "1.0.1",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./legacy-rc2-compat": {
      "types": "./lib/types/legacy-rc2-compat.d.ts",
      "default": "./lib/types/legacy-rc2-compat.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./wrapper": {
      "types": "./lib/types/wrapper.d.ts",
      "default": "./lib/types/wrapper.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/execa-*.js",
    "lib/legacy-rc2-compat.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-app-boot": "^0.1.0",
    "@deepseek-ai/dsh-page-app-profile": "^1.0.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0",
    "js-yaml": "^4.2.0",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^0.1.0",
    "@deepseek-ai/cordis-plugin-include": "^0.1.0",
    "@deepseek-ai/cordis-plugin-loader": "^0.1.0",
    "@deepseek-ai/dsh-brand": "^0.1.0",
    "@deepseek-ai/dsh-invariants": "^0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^0.1.0",
    "@deepseek-ai/cordis-plugin-include": "^0.1.0",
    "@deepseek-ai/cordis-plugin-loader": "^0.1.0",
    "@deepseek-ai/dsh-brand": "^0.1.0",
    "@deepseek-ai/dsh-invariants": "^0.1.0"
  },
  "private": false
}
