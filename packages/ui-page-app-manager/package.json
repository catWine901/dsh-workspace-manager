{
  "name": "@deepseek-ai/dsh-client-ui-page-app-manager",
  "description": "Workspace Apps client: React-free controller and authorization projection over the generated pageAppManager remote, the slot ledger, and the reconciled client graph",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^0.1.0",
    "@deepseek-ai/dsh-api-remotes": "^0.1.0",
    "@deepseek-ai/dsh-client-locale": "^0.1.0",
    "@deepseek-ai/dsh-client-modules": "^0.1.0",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0",
    "@deepseek-ai/dsh-invariants": "^0.1.0",
    "@deepseek-ai/dsh-page-app-manager": "^1.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^0.1.0",
    "@deepseek-ai/dsh-api-remotes": "^0.1.0",
    "@deepseek-ai/dsh-client-locale": "^0.1.0",
    "@deepseek-ai/dsh-client-modules": "^0.1.0",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0",
    "@deepseek-ai/dsh-invariants": "^0.1.0",
    "@deepseek-ai/dsh-page-app-manager": "^1.0.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "private": false
}
