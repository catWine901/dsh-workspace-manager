{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["hostBridgeVersion", "adapters"],
  "properties": {
    "hostBridgeVersion": { "const": 1 },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dshVersionRange", "adapterId", "adapterVersion", "rootIntegrationMode", "hostBridgeVersion", "testStatus", "knownLimitations"],
        "properties": {
          "dshVersionRange": { "type": "string", "pattern": "^=" },
          "adapterId": { "type": "string", "minLength": 1 },
          "adapterVersion": { "type": "string", "minLength": 1 },
          "rootIntegrationMode": { "enum": ["public-root-shell-seam", "layout-replacement"] },
          "hostBridgeVersion": { "const": 1 },
          "testStatus": { "enum": ["supported", "experimental", "unsupported"] },
          "knownLimitations": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
